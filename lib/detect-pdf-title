#!/usr/bin/env python3
"""
detect-pdf-title: guess a document's title from page 1 of an OCR'd PDF.

Reads the position and size of every line of text on page 1, skips page
furniture (addresses, phone numbers, emails, dates, page numbers), repairs
words that OCR split in two ("STATE MENT" -> "STATEMENT"), joins titles that
wrap onto several lines, then scores each candidate heading and prints the
best one. Bigger, higher-up, centered headings with document-type words
("Invoice", "Report", "Agreement"...) score highest.

Extra title words (one per line) can be added in:
    ~/.config/chaos-goblin/title-words.txt

Part of Chaos Goblin Delivery: https://github.com/mhoal11/chaos-goblin-delivery
"""

import html
import os
import re
import statistics
import subprocess
import sys


if len(sys.argv) != 2:
    print("Usage: detect-pdf-title PDF", file=sys.stderr)
    sys.exit(1)

pdf = sys.argv[1]


# ------------------------------------------------------------
# Words that usually mark a document's title
# ------------------------------------------------------------

TITLE_WORDS = {
    "ADDENDUM", "AGREEMENT", "ANNOUNCEMENT", "APPLICATION", "APPRAISAL",
    "ASSESSMENT", "AUTHORIZATION", "BILL", "BROCHURE", "BUDGET",
    "CERTIFICATE", "CHECKLIST", "CONFIRMATION", "CONTRACT", "DECLARATION",
    "DISCLOSURE", "ESTIMATE", "EVALUATION", "FORM", "GUIDE", "INVOICE",
    "INVITATION", "LEASE", "LETTER", "MANUAL", "MEMO", "MEMORANDUM",
    "MINUTES", "NOTICE", "ORDER", "PERMIT", "PLAN", "POLICY", "PROPOSAL",
    "QUOTE", "QUOTATION", "RECEIPT", "RECORD", "REGISTRATION", "RENEWAL",
    "REPORT", "REQUEST", "RESUME", "SCHEDULE", "STATEMENT", "SUMMARY",
    "TRANSCRIPT", "WARRANTY", "WORKSHEET",
}

extra = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "chaos-goblin", "title-words.txt",
)
if os.path.isfile(extra):
    with open(extra, encoding="utf-8") as fh:
        TITLE_WORDS |= {
            w.strip().upper() for w in fh
            if w.strip() and not w.lstrip().startswith("#")
        }


# Page furniture that is never the title.
SKIP_PATTERNS = [
    r"^PAGE \d+( OF \d+)?$",
    r"^\d+$",
    r"\b(TEL|PHONE|FAX|EMAIL|E-MAIL|WWW)\b",
    r"@",
    r"https?://|\.(COM|ORG|NET|GOV|EDU)\b",
    r"\(\d{3}\)\s*\d{3}|\b\d{3}[-. ]\d{3}[-. ]\d{4}\b",
    r"^(DATE|INVOICE|ACCOUNT|CUSTOMER|POLICY|ORDER|REF|REFERENCE)\s*(NO\.?|NUMBER|#|:)",
    r"^\d{1,6} [A-Z0-9 .]+ (ST|STREET|AVE|AVENUE|RD|ROAD|BLVD|DR|DRIVE|LN|LANE|WAY|CT|SUITE)\b",
    r"\b[A-Z]{2} \d{5}(-\d{4})?$",
    r"^(DEAR|SINCERELY|REGARDS)\b",
    r"^(JAN|FEB|MAR|APR|MAY|JUN|JUL|AUG|SEP|OCT|NOV|DEC)[A-Z]* \d{1,2},? \d{4}$",
    r"^\d{1,2}[/-]\d{1,2}[/-]\d{2,4}$",
]


def should_skip(text):
    upper = text.upper()
    return any(re.search(p, upper) for p in SKIP_PATTERNS)


def letters(text):
    return [c for c in text if c.isalpha()]


def uppercase_ratio(text):
    chars = letters(text)
    if not chars:
        return 0.0
    return sum(1 for c in chars if c.isupper()) / len(chars)


def clean_token(token):
    return re.sub(r"[^A-Za-z]", "", token)


def repair_split_words(text):
    """Join OCR splits like 'STATE MENT' -> 'STATEMENT' when the result is a title word."""
    tokens = text.split()
    output = []
    i = 0
    while i < len(tokens):
        if i + 1 < len(tokens):
            left, right = clean_token(tokens[i]), clean_token(tokens[i + 1])
            if (left + right).upper() in TITLE_WORDS and left.upper() not in TITLE_WORDS:
                prefix = re.match(r"^[^A-Za-z]*", tokens[i]).group(0)
                suffix = re.search(r"[^A-Za-z]*$", tokens[i + 1]).group(0)
                output.append(prefix + left + right + suffix)
                i += 2
                continue
        output.append(tokens[i])
        i += 1
    return " ".join(output)


# ------------------------------------------------------------
# Read page 1 with line positions and sizes
# ------------------------------------------------------------

try:
    result = subprocess.run(
        ["pdftotext", "-bbox-layout", "-f", "1", "-l", "1", pdf, "-"],
        capture_output=True, text=True, check=True,
    )
except Exception as exc:
    print(f"Could not extract PDF text: {exc}", file=sys.stderr)
    sys.exit(1)

page = re.search(r'<page width="([\d.]+)" height="([\d.]+)"', result.stdout)
if not page:
    print("No text found on page 1.", file=sys.stderr)
    sys.exit(1)

page_w, page_h = float(page.group(1)), float(page.group(2))

lines = []
for m in re.finditer(
    r'<line xMin="([\d.]+)" yMin="([\d.]+)" xMax="([\d.]+)" yMax="([\d.]+)">(.*?)</line>',
    result.stdout, re.S,
):
    x0, y0, x1, y1 = (float(v) for v in m.groups()[:4])
    words = [html.unescape(w) for w in re.findall(r">([^<]+)</word>", m.group(5))]
    text = re.sub(r"\s+", " ", " ".join(words)).strip()
    if text:
        lines.append({"x0": x0, "y0": y0, "x1": x1, "y1": y1,
                      "h": y1 - y0, "text": text})

lines.sort(key=lambda l: (l["y0"], l["x0"]))

if not lines:
    print("No text found on page 1.", file=sys.stderr)
    sys.exit(1)

body_h = statistics.median(l["h"] for l in lines) or 1.0


# ------------------------------------------------------------
# Build and score candidate headings
# ------------------------------------------------------------

def is_heading_like(line):
    return line["h"] >= body_h * 1.15 or uppercase_ratio(line["text"]) >= 0.8


candidates = []
continuations = set()   # lines already joined onto a heading above them

for i, line in enumerate(lines):

    text = repair_split_words(line["text"])

    if i in continuations or should_skip(text) or len(letters(text)) < 3:
        continue

    # Pull in wrapped title lines directly below, in the same style.
    collected = [text]
    last = line
    for j, nxt in enumerate(lines[i + 1:i + 4], start=i + 1):
        gap = nxt["y0"] - last["y1"]
        same_size = abs(nxt["h"] - line["h"]) <= line["h"] * 0.2
        if gap > line["h"] * 1.2 or not same_size or should_skip(nxt["text"]):
            break
        if not (is_heading_like(line) and is_heading_like(nxt)):
            break
        collected.append(repair_split_words(nxt["text"]))
        continuations.add(j)
        last = nxt

    title = re.sub(r"\s+", " ", " ".join(collected)).strip()
    title = re.sub(r"^\s*(?:\d+|[IVXLC]+)[.)]\s+", "", title)  # list numbering
    upper = title.upper()
    word_count = len(title.split())

    score = 0.0

    # Size: titles are usually larger than body text.
    score += min(line["h"] / body_h, 3.0) * 12

    # Document-type words.
    if any(re.search(r"\b" + re.escape(w) + r"\b", upper) for w in TITLE_WORDS):
        score += 25

    # ALL-CAPS or Title Case headings.
    ratio = uppercase_ratio(title)
    if ratio >= 0.9:
        score += 8
    elif all(w[:1].isupper() for w in title.split() if len(w) > 3 and w[:1].isalpha()):
        score += 4

    # Centered on the page.
    center = (line["x0"] + last["x1"]) / 2
    if abs(center - page_w / 2) < page_w * 0.08:
        score += 6

    # Near the top of the page.
    score += max(0.0, 1 - line["y0"] / (page_h * 0.6)) * 8

    # Sensible length.
    if 2 <= word_count <= 14:
        score += 6
    elif word_count > 20:
        score -= 15

    # Sentences (body text) end with a period.
    if title.endswith(".") and word_count > 6:
        score -= 12

    candidates.append((score, -i, title))


if not candidates:
    print("No likely document title detected.", file=sys.stderr)
    sys.exit(1)

candidates.sort(reverse=True)

print(candidates[0][2])
